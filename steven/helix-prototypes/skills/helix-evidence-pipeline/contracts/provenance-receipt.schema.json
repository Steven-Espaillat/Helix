{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/provenance-receipt/v1",
  "title": "HELIX Provenance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "candidate_id",
    "candidate_hash",
    "status",
    "enforcement_class",
    "waivable",
    "bindings",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "helix.provenance-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^PRV-[A-Z0-9-]+$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^SDC-[A-Z0-9-]+$"
    },
    "candidate_hash": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": ["passed", "blocked"]
    },
    "enforcement_class": {
      "const": "hard_blocker"
    },
    "waivable": {
      "const": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "text", "claim_id", "claim_hash", "artifact_hash"],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_hash": {
            "$ref": "#/$defs/sha256"
          },
          "artifact_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "location", "text", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
