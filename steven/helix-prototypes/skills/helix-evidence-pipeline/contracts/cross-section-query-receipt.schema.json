{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/cross-section-query-receipt/v1",
  "title": "HELIX Cross-Section Query Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "run_id",
    "section_package_id",
    "requested_artifact_ids",
    "returned",
    "rejected_artifact_ids",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "helix.cross-section-query-receipt/v1"
    },
    "query_id": {
      "type": "string",
      "pattern": "^CSQ-[A-Z0-9-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "section_package_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "returned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "hash"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["fact", "claim", "section_draft"]
          },
          "hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "rejected_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["returned", "rejected"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
