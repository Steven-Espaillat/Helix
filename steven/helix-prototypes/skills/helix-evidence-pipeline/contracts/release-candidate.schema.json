{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/release-candidate/v1",
  "title": "HELIX Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "export_eligible",
    "run_id",
    "study_id",
    "included_artifacts",
    "current_drafting_cycles",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.release-candidate/v1"
    },
    "status": {
      "const": "release_candidate",
      "not": {
        "const": "review_scaffold"
      }
    },
    "export_eligible": {
      "const": true
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "included_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "content_hash"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "pinned_run",
              "section_draft_candidate",
              "section_draft",
              "data_validation_receipt"
            ]
          },
          "content_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "current_drafting_cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_package_id", "cycle_id"],
        "properties": {
          "section_package_id": {
            "type": "string",
            "minLength": 1
          },
          "cycle_id": {
            "type": "string",
            "pattern": "^CYCLE-[A-Z0-9-]+$"
          }
        }
      }
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
