{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/section-draft/v1",
  "title": "HELIX Section Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "draft_id",
    "run_id",
    "section_id",
    "candidate_id",
    "candidate_hash",
    "content_hash",
    "promoted_at",
    "gate_decision_ids",
    "bound_dispositions"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.section-draft/v1"
    },
    "status": {
      "const": "section_draft"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^SD-[A-Z0-9-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^SDC-[A-Z0-9-]+$"
    },
    "candidate_hash": {
      "$ref": "#/$defs/sha256"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bound_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition_id",
          "result_id",
          "decision",
          "artifact_hash",
          "dependency_fingerprint"
        ],
        "properties": {
          "disposition_id": {
            "type": "string",
            "minLength": 1
          },
          "result_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "artifact_hash": {
            "$ref": "#/$defs/sha256"
          },
          "dependency_fingerprint": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
