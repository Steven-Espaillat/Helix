{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/section-draft-candidate/v1",
  "title": "HELIX Section Draft Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_id",
    "run_id",
    "section_id",
    "section_package_id",
    "section_package_version",
    "drafting_cycle_id",
    "attempt",
    "validated_claim_ids",
    "content_blocks",
    "executor_receipt_ids",
    "agent_receipt"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "helix.section-draft-candidate/v1"
    },
    "status": {
      "type": "string",
      "const": "section_draft_candidate"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^SDC-[A-Z0-9-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "section_package_id": {
      "type": "string",
      "minLength": 1
    },
    "section_package_version": {
      "$ref": "#/$defs/semver"
    },
    "drafting_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "validated_claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "kind", "content", "factual_spans"],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["paragraph", "table"]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/tableContent"
              }
            ]
          },
          "factual_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "claim_ids"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "executor_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "thread_id", "skill_name", "skill_hash", "skill_references_hash"],
      "properties": {
        "runtime": {
          "type": "string",
          "const": "codex_sdk"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_name": {
          "type": "string",
          "const": "helix-section-agent"
        },
        "skill_hash": {
          "$ref": "#/$defs/sha256"
        },
        "skill_references_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "tableContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cells"],
            "properties": {
              "cells": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "claim_ids"],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claim_ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
