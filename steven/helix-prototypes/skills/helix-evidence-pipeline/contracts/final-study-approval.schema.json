{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/final-study-approval/v1",
  "title": "HELIX Final Study Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "study_id",
    "reviewer",
    "recorded_at",
    "manifest_hash",
    "included_artifact_hashes",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.final-study-approval/v1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^FSA-[A-Z0-9-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "included_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "content_hash"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
